{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTableStream",
      "Effect": "Allow",
      "Action": ["dynamodb:DescribeStream", "dynamodb:GetRecords", "dynamodb:GetShardIterator", "dynamodb:ListStreams"],
      "Resource": "${stream_arn}"
    },
    {
      "Sid": "InvokeAuditLambdaOnly",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": "${audit_function_arn}"
    }
  ]
}
