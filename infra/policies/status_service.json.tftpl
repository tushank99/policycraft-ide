{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequestTableAccess",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Scan"],
      "Resource": "${table_arn}"
    },
    {
      "Sid": "EnqueueGenerationJobs",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "${queue_arn}"
    },
    {
      "Sid": "WriteOwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "${log_group_arn}:log-stream:*"
    }
  ]
}
