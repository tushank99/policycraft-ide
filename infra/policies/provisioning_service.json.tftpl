{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRequestMetadata",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": "${table_arn}"
    },
    {
      "Sid": "ReadGeneratedArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "${artifacts_bucket_arn}/generated/*"
    },
    {
      "Sid": "ReadGithubToken",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": "${github_param_arn}"
    },
    {
      "Sid": "WriteOwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "${log_group_arn}:log-stream:*"
    }
  ]
}
