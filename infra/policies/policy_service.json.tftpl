{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PolicyProfileReadWrite",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem"],
      "Resource": "${table_arn}"
    },
    {
      "Sid": "WriteOwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "${log_group_arn}:log-stream:*"
    }
  ]
}
